# Copy to .env.local and fill in. Never commit .env.local.

# Public backend URL, inlined into the client bundle at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# URL the app is served from. Use localhost, not 127.0.0.1: the backend's CORS allows only this origin.
NEXTAUTH_URL=http://localhost:3000

# Random string of 32+ bytes, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=

# Optional: backend URL for server-side requests, e.g. http://backend:8080 in Docker.
# BACKEND_INTERNAL_URL=

# Optional: comma-separated LAN hosts allowed to open the dev server, e.g. 192.168.1.10 for testing on a phone.
# DEV_ALLOWED_ORIGINS=
